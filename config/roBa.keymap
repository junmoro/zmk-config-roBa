#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <200>;
};

&lt {
    flavor = "balanced";
    quick-tap-ms = <200>;
};

&trackball {
    // automouse-layer = <4>;

    scroll-layers = <5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        colon {
            bindings = <&kp COLON>;
            key-positions = <9 21>;
        };

        question {
            bindings = <&kp QUESTION>;
            key-positions = <21 33>;
        };

        left_brace {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <5 17>;
        };

        right_brace {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <6 18>;
        };

        left_bracket {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <17 29>;
        };

        right_bracket {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <18 30>;
        };

        left_parenthesis {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <7 19>;
        };

        right_parenthesis {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <8 20>;
        };

        less_than {
            bindings = <&kp LESS_THAN>;
            key-positions = <19 31>;
        };

        greater_than {
            bindings = <&kp GREATER_THAN>;
            key-positions = <20 32>;
        };

        underscore {
            bindings = <&kp UNDERSCORE>;
            key-positions = <5 6>;
        };

        minus {
            bindings = <&kp MINUS>;
            key-positions = <17 18>;
        };

        plus {
            bindings = <&kp PLUS>;
            key-positions = <6 7>;
        };

        equal {
            bindings = <&kp EQUAL>;
            key-positions = <18 19>;
        };

        duble_quotes {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <29 30>;
        };

        single_quote {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <30 31>;
        };

        exclamation {
            bindings = <&kp EXCLAMATION>;
            key-positions = <0 10>;
        };

        at_sign {
            bindings = <&kp AT_SIGN>;
            key-positions = <1 11>;
        };

        hash {
            bindings = <&kp HASH>;
            key-positions = <2 12>;
        };

        dollar {
            bindings = <&kp DOLLAR>;
            key-positions = <3 13>;
        };

        percent {
            bindings = <&kp PERCENT>;
            key-positions = <4 14>;
        };

        caret {
            bindings = <&kp CARET>;
            key-positions = <10 22>;
        };

        ampersand {
            bindings = <&kp AMPERSAND>;
            key-positions = <11 23>;
        };

        asterisk {
            bindings = <&kp ASTERISK>;
            key-positions = <12 24>;
        };

        pipe {
            bindings = <&kp PIPE>;
            key-positions = <14 13>;
        };

        backslash {
            bindings = <&kp BACKSLASH>;
            key-positions = <13 12>;
        };

        tilde {
            bindings = <&kp TILDE>;
            key-positions = <26 25>;
        };

        grave {
            bindings = <&kp GRAVE>;
            key-positions = <25 24>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q        &kp W      &kp E         &kp R                     &kp T                                                                       &kp Y        &kp U  &kp I      &kp O    &kp P
&kp A        &kp S      &lt 3 D       &kp F                     &kp G                   &kp LS(LG(NUMBER_4))      &kp LS(LC(LG(NUMBER_4)))  &kp H        &kp J  &kp K      &kp L    &mt RIGHT_CONTROL SEMI
&kp Z        &kp X      &kp C         &kp V                     &kp B                   &kp LEFT_CONTROL          &lt 4 ESCAPE              &kp N        &kp M  &kp COMMA  &kp DOT  &mt RIGHT_ALT SLASH
&lt 6 LC(Q)  &kp LC(W)  &kp LEFT_ALT  &mt LEFT_SHIFT LC(SPACE)  &mt LS(LEFT_GUI) SPACE  &mt LEFT_GUI TAB          &mt RIGHT_GUI BACKSPACE   &lt 2 ENTER                             &lt 5 DEL
            >;
        };

        SYMBOLS {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        NUM {
            bindings = <
&trans        &trans        &trans        &trans        &trans                      &trans        &kp F12       &kp F11  &trans  &trans
&kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5  &trans      &trans  &kp NUMBER_6  &kp NUMBER_7  &kp N8   &kp N9  &kp N0
&kp F1        &kp F2        &kp F3        &kp F4        &kp F5  &trans      &trans  &kp F6        &kp F7        &kp F8   &kp F9  &kp F10
&trans        &trans        &trans        &trans        &trans  &trans      &trans  &trans                                       &trans
            >;
        };

        ARROW {
            bindings = <
&trans  &trans  &trans  &trans    &trans                          &kp HOME        &kp LC(A)           &kp LC(E)            &kp END          &trans
&trans  &trans  &trans  &mkp MB1  &mkp MB2  &mkp MB3      &trans  &kp LEFT_ARROW  &kp DOWN_ARROW      &kp UP_ARROW         &kp RIGHT_ARROW  &trans
&trans  &trans  &trans  &mkp MB4  &mkp MB5  &trans        &trans  &trans          &kp LA(LEFT_ARROW)  &kp LA(RIGHT_ARROW)  &trans           &trans
&trans  &trans  &trans  &trans    &trans    &trans        &trans  &trans                                                                    &trans
            >;
        };

        MOUSE {
            bindings = <
&kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp SLASH     &trans                      &kp HOME  &kp LC(A)  &kp LC(E)  &kp END   &trans
&kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp ASTERISK  &trans  &trans      &trans  &trans    &mkp MB1   &mkp MB2   &mkp MB3  &trans
&kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp MINUS     &trans  &trans      &trans  &trans    &mkp MB4   &mkp MB5   &trans    &trans
&kp KP_NUMBER_0  &kp KP_DOT       &kp EQUAL        &kp KP_PLUS   &trans  &trans      &trans  &trans                                    &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        CONTROL {
            bindings = <
&kp LS(LC(Q))       &kp LS(LC(W))       &kp LS(LC(MINUS))  &kp LS(LC(EQUAL))    &kp LS(LC(K))                                    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2       &bt BT_SEL 3     &bt BT_SEL 4
&kp LS(LC(A))       &kp LS(LC(S))       &kp LS(LC(Z))      &kp LS(LC(X))        &kp LS(LC(C))  &kp LS(LC(E))      &kp LC(LG(Q))  &trans        &kp K_MUTE    &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &trans
&kp LC(LEFT_ARROW)  &kp LC(DOWN_ARROW)  &kp LC(UP_ARROW)   &kp LC(RIGHT_ARROW)  &trans         &trans             &trans         &trans        &kp F14       &kp F15            &trans           &bt BT_CLR
&trans              &trans              &trans             &trans               &trans         &trans             &trans         &trans                                                          &bt BT_CLR_ALL
            >;
        };
    };
};
