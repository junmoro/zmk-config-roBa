#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <200>;
};

&lt {
    flavor = "balanced";
    quick-tap-ms = <200>;
};

&trackball {
    // automouse-layer = <4>;

    scroll-layers = <5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <20 21>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q        &kp W  &kp E    &kp R                     &kp T                                                                               &kp Y        &kp U  &kp I      &kp O    &kp P
&kp A        &kp S  &lt 3 D  &kp F                     &kp G        &mt LEFT_ALT LS(LG(NUMBER_4))      &mt RIGHT_ALT LS(LC(LG(NUMBER_4)))  &kp H        &kp J  &kp K      &kp L    &mt RIGHT_CONTROL SEMI
&kp Z        &kp X  &kp C    &kp V                     &kp B        &mt LEFT_CONTROL LC(TAB)           &lt 4 ESCAPE                        &kp N        &kp M  &kp COMMA  &kp DOT  &lt 5 SLASH
&lt 6 LC(Q)  &none  &none    &mt LEFT_SHIFT LC(SPACE)  &lt 1 SPACE  &mt LEFT_GUI TAB                   &mt RIGHT_GUI BACKSPACE             &lt 2 ENTER                             &mt RIGHT_SHIFT DEL
            >;
        };

        SYMBOLS {
            bindings = <
&trans           &kp PIPE       &kp TILDE  &kp DOUBLE_QUOTES  &trans                                      &trans     &kp UNDERSCORE  &kp PLUS      &kp LEFT_BRACE        &kp RIGHT_BRACE
&kp EXCLAMATION  &kp AT_SIGN    &kp HASH   &kp DOLLAR         &kp PERCENT  &trans      &trans             &kp CARET  &kp AMPERSAND   &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&trans           &kp BACKSLASH  &kp GRAVE  &kp SQT            &trans       &trans      &kp RIGHT_CONTROL  &trans     &kp MINUS       &kp EQUAL     &kp LEFT_BRACKET      &kp RIGHT_BRACKET
&trans           &trans         &trans     &trans             &trans       &trans      &trans             &trans                                                         &trans
            >;
        };

        NUM {
            bindings = <
&trans        &trans        &trans        &trans        &trans                                 &trans        &kp F12       &kp F11  &trans  &trans
&kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5  &trans      &trans             &kp NUMBER_6  &kp NUMBER_7  &kp N8   &kp N9  &kp N0
&kp F1        &kp F2        &kp F3        &kp F4        &kp F5  &trans      &kp RIGHT_CONTROL  &kp F6        &kp F7        &kp F8   &kp F9  &kp F10
&trans        &trans        &trans        &trans        &trans  &trans      &trans             &trans                                       &trans
            >;
        };

        ARROW {
            bindings = <
&trans  &trans  &trans  &trans    &trans                          &kp HOME        &kp LC(A)           &kp LC(E)            &kp END          &trans
&trans  &trans  &trans  &mkp MB1  &mkp MB2  &mkp MB3      &trans  &kp LEFT_ARROW  &kp DOWN_ARROW      &kp UP_ARROW         &kp RIGHT_ARROW  &trans
&trans  &trans  &trans  &mkp MB4  &mkp MB5  &trans        &trans  &trans          &kp LA(LEFT_ARROW)  &kp LA(RIGHT_ARROW)  &trans           &trans
&trans  &trans  &trans  &trans    &trans    &trans        &trans  &trans                                                                    &trans
            >;
        };

        MOUSE {
            bindings = <
&kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp SLASH     &trans                      &kp HOME  &kp LC(A)  &kp LC(E)  &kp END   &trans
&kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp ASTERISK  &trans  &trans      &trans  &trans    &mkp MB1   &mkp MB2   &mkp MB3  &trans
&kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp MINUS     &trans  &trans      &trans  &trans    &mkp MB4   &mkp MB5   &trans    &trans
&kp KP_NUMBER_0  &kp KP_DOT       &kp EQUAL        &kp KP_PLUS   &trans  &trans      &trans  &trans                                    &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        CONTROL {
            bindings = <
&kp LS(LC(Q))       &kp LS(LC(W))       &kp LS(LC(MINUS))  &kp LS(LC(EQUAL))    &kp LS(LC(K))                             &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2       &bt BT_SEL 3     &bt BT_SEL 4
&kp LS(LC(A))       &kp LS(LC(S))       &kp LS(Z)          &kp LS(LC(X))        &kp LS(LC(C))  &trans      &kp LC(LG(Q))  &trans        &kp K_MUTE    &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &trans
&kp LC(LEFT_ARROW)  &kp LC(DOWN_ARROW)  &kp LC(UP_ARROW)   &kp LC(RIGHT_ARROW)  &trans         &trans      &bootloader    &trans        &kp F14       &kp F15            &trans           &bt BT_CLR
&trans              &trans              &trans             &trans               &trans         &trans      &trans         &trans                                                          &bt BT_CLR_ALL
            >;
        };
    };
};
